   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
    background-color: #0f0f10;
    font-family: Nunito;
}

QGroupBox {
    background-color: #111112;
    border: 1px solid #303033;
    border-radius: 4px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    margin-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    background-color: #0f0f10;
}

QLabel {
    color: #ffffff;
    font-size: 10px;
    font-weight: 500;
    padding: 0;
    margin: 0;
}

QGroupBox[liftPanel=&quot;true&quot;] {
    min-width: 194px;
    max-width: 194px;
    min-height: 326px;
    max-height: 326px;
}

QLabel[shaftCell=&quot;true&quot;] {
    background-color: #0f0f10;
    border: 1px solid #1f8fff;
    color: #20c7ff;
    font-size: 10px;
    font-weight: 700;
    min-width: 136px;
    max-width: 136px;
    min-height: 24px;
    max-height: 24px;
}

QLabel[liftFloorLabel=&quot;true&quot;] {
    min-width: 24px;
    max-width: 24px;
}

QLabel[callFloorLabel=&quot;true&quot;] {
    min-width: 54px;
    max-width: 54px;
}

QLabel[activeLift=&quot;true&quot;] {
    background-color: rgba(0, 104, 255, 0.22);
    border: 1px solid #0b7cff;
    color: #20c7ff;
    font-size: 10px;
    font-weight: 900;
}

QPushButton[activeRequest=&quot;true&quot;] {
    background-color: rgba(0, 104, 255, 0.22);
    border-color: #0b7cff;
    color: #20c7ff;
}

QPushButton[activeRequest=&quot;true&quot;]:hover {
    background-color: rgba(0, 104, 255, 0.22);
    border-color: #0b7cff;
    color: #20c7ff;
}

QLabel[statusValue=&quot;true&quot;] {
    background-color: #29292a;
    border: 1px solid #38383a;
    border-radius: 4px;
    color: #ffffff;
    min-height: 16px;
    padding: 2px 6px;
}

QLabel[statusName=&quot;true&quot;] {
    min-width: 70px;
}

QPushButton {
    background-color: #2a2a2b;
    border: 1px solid #3a3a3d;
    border-radius: 3px;
    color: #ffffff;
    font-size: 10px;
    font-weight: 700;
    min-height: 20px;
    padding: 1px 4px;
}

QPushButton:hover {
    background-color: #333335;
    border-color: #4a4a4d;
}

QPushButton:pressed {
    background-color: #0068ff;
    border-color: #0b7cff;
}

QPushButton[cabinButton=&quot;true&quot;] {
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
}

QPushButton[hallCallButton=&quot;true&quot;] {
    min-width: 86px;
    min-height: 30px;
}</string>
