   <property name="styleSheet">
    <string notr="true">QMainWindow {
    background-color: #1e1e24;
}

QGroupBox {
    background-color: #2a2a32;
    border: 2px solid #3f3f46;
    border-radius: 8px;
    margin-top: 20px;
    font-weight: 800;
    font-size: 16px;
    color: #e4e4e7;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    left: 10px;
}

QLabel {
    color: #a1a1aa;
    font-size: 12px;
    font-weight: 500;
}

QLabel[frameShape=&quot;1&quot;] { 
    background-color: #111115;
    border: 2px solid #3f3f46;
    border-radius: 6px;
    color: #06b6d4; 
    font-weight: bold;
    font-size: 14px;
    letter-spacing: 2px;
}

QLabel[text=&quot;ЛИФТ&quot;] {
    background-color: rgba(6, 182, 212, 0.15);
    border-color: #06b6d4;
    color: #06b6d4;
    font-size: 18px; 
    font-weight: 900;
}

QPushButton {
    background-color: #3f3f46;
    color: #f4f4f5;
    border: 1px solid #52525b;
    border-radius: 6px;
    padding: 5px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #52525b;
    border-color: #71717a;
}

QPushButton:pressed {
    background-color: #27272a;
}

QGroupBox#cabinGroupBox QPushButton {
    background-color: #27272a;
    border: 2px solid #3f3f46;
    border-radius: 16px; 
    color: #fbbf24; 
    font-size: 14px;
}

QGroupBox#cabinGroupBox QPushButton:hover {
    background-color: #3f3f46;
    border-color: #fbbf24;
}

QGroupBox#cabinGroupBox QPushButton:pressed {
    background-color: #fbbf24;
    color: #1e1e24;
}

QPushButton#floor1Button, QPushButton#floor2Button, QPushButton#floor3Button, QPushButton#floor4Button, QPushButton#floor5Button {
    background-color: #d97706;
    color: #ffffff;
    border: none;
}

QPushButton#floor1Button:hover, QPushButton#floor2Button:hover, QPushButton#floor3Button:hover, QPushButton#floor4Button:hover, QPushButton#floor5Button:hover {
    background-color: #f59e0b;
}

QPushButton#floor1Button:pressed, QPushButton#floor2Button:pressed, QPushButton#floor3Button:pressed, QPushButton#floor4Button:pressed, QPushButton#floor5Button:pressed {
    background-color: #b45309;
}

QLabel#floor1Label, QLabel#floor2Label, QLabel#floor3Label, QLabel#floor4Label, QLabel#floor5Label {
    font-size: 16px;
    font-weight: bold;
    color: #e4e4e7; 
}

QGroupBox#stateGroupBox QLabel {
    font-size: 16px;
    font-weight: 600;
    color: #f4f4f5;
}</string>
