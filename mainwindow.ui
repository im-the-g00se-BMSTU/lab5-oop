   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
    background-color: #0f0f10;
    font-family: &quot;Nunito&quot;;
}

QGroupBox {
    background-color: #111112;
    border: 1px solid #303033;
    border-radius: 6px;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    font-family: &quot;Nunito&quot;;
    margin-top: 18px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 18px;
    padding: 0 8px;
    background-color: #0f0f10;
}

QLabel {
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    font-family: &quot;Nunito&quot;;
}

QLabel[frameShape=&quot;1&quot;] {
    background-color: #0f0f10;
    border: 1px solid #1f8fff;
    border-radius: 0;
    color: #20c7ff;
    font-size: 14px;
    font-weight: 700;
}

QLabel[activeLift=&quot;true&quot;] {
    background-color: rgba(0, 104, 255, 0.22);
    border: 1px solid #0b7cff;
    color: #20c7ff;
    font-size: 18px;
    font-weight: 900;
}

QPushButton {
    background-color: #2a2a2b;
    border: 1px solid #3a3a3d;
    border-radius: 5px;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    font-family: &quot;Nunito&quot;;
    min-height: 42px;
    padding: 6px 18px;
}

QPushButton:hover {
    background-color: #333335;
    border-color: #4a4a4d;
}

QPushButton:pressed {
    background-color: #0068ff;
    border-color: #0b7cff;
}

QLabel#floor1Label, QLabel#floor2Label, QLabel#floor3Label, QLabel#floor4Label, QLabel#floor5Label {
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
}

QGroupBox#stateGroupBox QLabel {
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
}

QLabel#currentFloorValueLabel, QLabel#targetFloorValueLabel, QLabel#controllerStateValueLabel, QLabel#cabinStateValueLabel, QLabel#doorStateValueLabel {
    background-color: #29292a;
    border: 1px solid #38383a;
    border-radius: 4px;
    color: #ffffff;
    min-height: 32px;
    padding: 4px 12px;
}</string>
